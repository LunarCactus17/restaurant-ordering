{
  "name": "restaurant-ordering",
  "version": "0.1.0",
  "private": true,
  "bin": "scripts/print-agent-pkg-entry.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "print:agent:once": "tsx scripts/print-agent.ts",
    "print:agent:loop": "tsx scripts/print-agent-daemon.ts",
    "print:test-job": "tsx scripts/create-test-print-job.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "next": "16.4.2",
    "pdf-to-printer": "^5.8.1",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/client": "^6.16.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@yao-pkg/pkg": "^6.23.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^6.16.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pkg": {
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist-print-agent",
    "scripts": [
      "scripts/**/*.js",
      "scripts/**/*.ts",
      "src/**/*.ts"
    ],
    "assets": [
      "node_modules/.prisma/client/**/*",
      "node_modules/@prisma/client/**/*",
      "node_modules/@prisma/engines/**/*",
      "node_modules/pdf-to-printer/dist/**/*",
      "prisma/schema.prisma",
      "prisma/dev.db"
    ]
  }
}
