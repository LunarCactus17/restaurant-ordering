{
  "bin": "scripts/print-agent-pkg-entry.js",
  "pkg": {
    "targets": ["node20-win-x64"],
    "outputPath": "dist-print-agent",
    "scripts": [
      "scripts/print-agent-pkg-entry.js",
      "scripts/print-agent-daemon.ts",
      "src/lib/print-agent.ts",
      "src/lib/print-receipt.ts",
      "src/lib/prisma.ts",
      "src/lib/types.ts"
    ],
    "assets": [
      "node_modules/.prisma/client/**/*",
      "node_modules/@prisma/client/**/*",
      "node_modules/@prisma/engines/**/*",
      "node_modules/pdf-to-printer/dist/**/*",
      "prisma/schema.prisma",
      "prisma/dev.db"
    ]
  }
}
